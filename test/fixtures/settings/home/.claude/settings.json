{
  // user layer (comments and a trailing comma on purpose)
  "model": "claude-opus-4-1",
  "effortLevel": "medium",
  "env": { "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000", "MY_API_KEY": "fake-value-should-not-leak-123" },
  "permissions": { "defaultMode": "acceptEdits", "allow": ["Bash(git status:*)", "Read"], "deny": ["Bash(rm -rf:*)"] },
