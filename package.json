{
  "name": "agent-vscode",
  "displayName": "DataPass Agent",
  "description": "Local observer for Claude Code and Codex sessions: what is running, where, and what changed.",
  "version": "0.11.9",
  "publisher": "juliandatapass",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/julian-passebecq/agent-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/julian-passebecq/agent-vscode/issues"
  },
  "homepage": "https://github.com/julian-passebecq/agent-vscode#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:agent.workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Agent reads only provider artifacts in your user profile. In untrusted workspaces Git correlation is disabled."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent",
          "title": "Agent",
          "icon": "media/agent.svg"
        }
      ]
    },
    "views": {
      "agent": [
        {
          "id": "agent.analyzer",
          "name": "Analyzer"
        },
        {
          "id": "agent.cockpit",
          "name": "Cockpit",
          "type": "webview",
          "visibility": "collapsed"
        },
        {
          "id": "agent.sessions",
          "name": "Sessions",
          "visibility": "collapsed"
        },
        {
          "id": "agent.timeline",
          "name": "Timeline",
          "type": "webview",
          "visibility": "collapsed"
        },
        {
          "id": "agent.activity",
          "name": "Activity",
          "type": "webview",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "agent.refresh",
        "title": "Agent: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agent.openWorkspace",
        "title": "Agent: Open Workspace",
        "icon": "$(layout)"
      },
      {
        "command": "agent.openWorkspaceNewTab",
        "title": "Agent: Open Workspace in New Tab",
        "icon": "$(add)"
      },
      {
        "command": "agent.openAttention",
        "title": "Agent: Show Attention Queue"
      },
      {
        "command": "agent.openTeam",
        "title": "Agent: Show Team (workers)"
      },
      {
        "command": "agent.openSession",
        "title": "Agent: Open Session Inspector"
      },
      {
        "command": "agent.openTimeline",
        "title": "Agent: Show Session Timeline"
      },
      {
        "command": "agent.revealWorktree",
        "title": "Agent: Reveal Worktree"
      },
      {
        "command": "agent.copySessionId",
        "title": "Agent: Copy Session Id"
      },
      {
        "command": "agent.openInTern",
        "title": "Agent: Open in Tern",
        "enablement": "agent.ternAvailable"
      },
      {
        "command": "agent.showDiagnostics",
        "title": "Agent: Show Diagnostics"
      },
      {
        "command": "agent.readTranscript",
        "title": "Agent: Read Session Transcript"
      },
      {
        "command": "agent.goToScreen",
        "title": "Agent: Go to screen…"
      },
      {
        "title": "DataPass: Start Here",
        "command": "agent.knowledge"
      },
      {
        "title": "DataPass: Export Selected Conversations",
        "command": "agent.exportConversations"
      },
      {
        "command": "agent.openAnalyzer",
        "title": "Agent: Open Analyzer"
      },
      {
        "command": "agent.openCurrentProject",
        "title": "Agent: Open Current Project"
      },
      {
        "command": "agent.exportSelection",
        "title": "Agent: Export Selection"
      },
      {
        "command": "agent.inspectChangeInLens",
        "title": "Agent: Inspect Change in Lens",
        "enablement": "agent.ternAvailable"
      },
      {
        "command": "agent.openCommitInLens",
        "title": "Agent: Open Observed Commit in Lens",
        "enablement": "agent.ternAvailable"
      },
      {
        "command": "agent.openChangedFileInLens",
        "title": "Agent: Open Changed File in Lens",
        "enablement": "agent.ternAvailable"
      },
      {
        "command": "agent.openControlMap",
        "title": "Agent: Open Agent Map"
      },
      {
        "command": "agent.openCompact",
        "title": "Agent: Open Compact"
      },
      {
        "command": "agent.reviewCockpitScope",
        "title": "Agent: Review Cockpit Scope"
      },
      {
        "command": "agent.inspectSelectedProcess",
        "title": "Agent: Inspect Selected Process Metadata"
      },
      {
        "command": "agent.revokeCockpitScopes",
        "title": "Agent: Revoke Cockpit Scopes"
      },
      {
        "command": "agent.importCockpitReceipts",
        "title": "Agent: Import Scoped Context and Asset Receipts"
      },
      {
        "command": "agent.exportIncremental",
        "title": "Agent: Export Reviewed Incremental Sessions"
      },
      {
        "command": "agent.selectAssetRoot",
        "title": "Agent: Select Asset Root"
      },
      {
        "command": "agent.inspectSelectedResources",
        "title": "Agent: Inspect Selected Diagnostic Resources"
      },
      {
        "command": "agent.importImageReceipt",
        "title": "Agent: Import Scoped Image Producer Receipt"
      },
      {
        "command": "agent.numberedScreen0",
        "title": "Agent: Numbered Screen 0"
      },
      {
        "command": "agent.numberedScreen1",
        "title": "Agent: Numbered Screen 1"
      },
      {
        "command": "agent.numberedScreen2",
        "title": "Agent: Numbered Screen 2"
      },
      {
        "command": "agent.numberedScreen3",
        "title": "Agent: Numbered Screen 3"
      },
      {
        "command": "agent.numberedScreen4",
        "title": "Agent: Numbered Screen 4"
      },
      {
        "command": "agent.numberedScreen5",
        "title": "Agent: Numbered Screen 5"
      },
      {
        "command": "agent.numberedScreen6",
        "title": "Agent: Numbered Screen 6"
      },
      {
        "command": "agent.numberedScreen7",
        "title": "Agent: Numbered Screen 7"
      },
      {
        "command": "agent.numberedScreen8",
        "title": "Agent: Numbered Screen 8"
      },
      {
        "command": "agent.numberedScreen9",
        "title": "Agent: Numbered Screen 9"
      },
      {
        "command": "agent.reviewNativePlatformVerifier",
        "title": "Agent: Review Independent Native Platform Verifier"
      },
      {
        "command": "agent.revokeAgentHostConnections",
        "title": "Agent: Revoke Agent Host Source and Connection Grants"
      }
    ],
    "keybindings": [
      {
        "command": "agent.goToScreen",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "activeWebviewPanelId == 'agent.workspace'"
      },
      {
        "command": "agent.numberedScreen0",
        "key": "ctrl+alt+0",
        "mac": "cmd+alt+0",
        "when": "activeWebviewPanelId == 'agent.workspace' && !inputFocus"
      },
      {
        "command": "agent.numberedScreen1",
        "key": "ctrl+alt+1",
        "mac": "cmd+alt+1",
        "when": "activeWebviewPanelId == 'agent.workspace' && !inputFocus"
      },
      {
        "command": "agent.numberedScreen2",
        "key": "ctrl+alt+2",
        "mac": "cmd+alt+2",
        "when": "activeWebviewPanelId == 'agent.workspace' && !inputFocus"
      },
      {
        "command": "agent.numberedScreen3",
        "key": "ctrl+alt+3",
        "mac": "cmd+alt+3",
        "when": "activeWebviewPanelId == 'agent.workspace' && !inputFocus"
      },
      {
        "command": "agent.numberedScreen4",
        "key": "ctrl+alt+4",
        "mac": "cmd+alt+4",
        "when": "activeWebviewPanelId == 'agent.workspace' && !inputFocus"
      },
      {
        "command": "agent.numberedScreen5",
        "key": "ctrl+alt+5",
        "mac": "cmd+alt+5",
        "when": "activeWebviewPanelId == 'agent.workspace' && !inputFocus"
      },
      {
        "command": "agent.numberedScreen6",
        "key": "ctrl+alt+6",
        "mac": "cmd+alt+6",
        "when": "activeWebviewPanelId == 'agent.workspace' && !inputFocus"
      },
      {
        "command": "agent.numberedScreen7",
        "key": "ctrl+alt+7",
        "mac": "cmd+alt+7",
        "when": "activeWebviewPanelId == 'agent.workspace' && !inputFocus"
      },
      {
        "command": "agent.numberedScreen8",
        "key": "ctrl+alt+8",
        "mac": "cmd+alt+8",
        "when": "activeWebviewPanelId == 'agent.workspace' && !inputFocus"
      },
      {
        "command": "agent.numberedScreen9",
        "key": "ctrl+alt+9",
        "mac": "cmd+alt+9",
        "when": "activeWebviewPanelId == 'agent.workspace' && !inputFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agent.refresh",
          "when": "view == agent.sessions || view == agent.cockpit",
          "group": "navigation"
        },
        {
          "command": "agent.openWorkspace",
          "when": "view == agent.cockpit || view == agent.sessions",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "agent.openSession",
          "when": "view == agent.sessions && viewItem =~ /session/",
          "group": "1_open@1"
        },
        {
          "command": "agent.openTimeline",
          "when": "view == agent.sessions && viewItem =~ /session/",
          "group": "1_open@2"
        },
        {
          "command": "agent.revealWorktree",
          "when": "view == agent.sessions && viewItem =~ /session/",
          "group": "2_nav@1"
        },
        {
          "command": "agent.openInTern",
          "when": "view == agent.sessions && viewItem =~ /session/ && agent.ternAvailable",
          "group": "2_nav@2"
        },
        {
          "command": "agent.copySessionId",
          "when": "view == agent.sessions && viewItem =~ /session/",
          "group": "3_copy@1"
        },
        {
          "command": "agent.openTeam",
          "when": "view == agent.sessions && viewItem =~ /session/",
          "group": "1_open@3"
        },
        {
          "command": "agent.openWorkspace",
          "when": "view == agent.sessions && viewItem =~ /session/",
          "group": "1_open@0"
        },
        {
          "command": "agent.exportConversations",
          "when": "view == agent.sessions && viewItem == session",
          "group": "knowledge"
        }
      ],
      "commandPalette": [
        {
          "command": "agent.openInTern",
          "when": "agent.ternAvailable"
        }
      ]
    },
    "configuration": {
      "title": "Agent",
      "properties": {
        "agent.historyDays": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 30,
          "description": "How many days of provider session history to load."
        },
        "agent.maxSessions": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "maximum": 2000,
          "description": "Upper bound on session artifacts ingested."
        },
        "agent.claude.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Observe Claude Code sessions (~/.claude)."
        },
        "agent.codex.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Observe Codex sessions (~/.codex)."
        },
        "agent.idleMinutes": {
          "type": "number",
          "default": 10,
          "description": "Minutes without activity before an open session is shown as IDLE rather than RUNNING (Codex)."
        },
        "agent.idleAlertMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "Minutes an IDLE session waits before it appears in the Attention queue."
        },
        "agent.projects": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "match": {
                "type": "string"
              },
              "company": {
                "type": "string"
              },
              "project": {
                "type": "string"
              }
            },
            "required": [
              "match"
            ]
          },
          "description": "Maps sessions to company / project for the Projects screen. match is a path prefix, a glob (* ? **) or a bare repository folder name; the most specific rule wins. Unmatched sessions are inferred from the path."
        },
        "agent.repos.maxRepos": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Repositories screen: most repositories read (live first, then most recent session activity)."
        },
        "agent.repos.maxWorktrees": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "Repositories screen: most worktrees per repository whose git status is read (worktrees with live sessions first)."
        },
        "agent.repos.commits": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "description": "Repositories screen: recent commits listed per repository (0 = off)."
        },
        "agent.repos.untracked": {
          "type": "boolean",
          "default": true,
          "description": "Repositories screen: count untracked files (false is faster)."
        },
        "agent.repos.extra": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Repositories screen: extra repository paths always shown, even without a session."
        },
        "agent.catalog.extraRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Catalog screen: extra repository folders to scan for project-level .claude / .codex configuration."
        },
        "agent.catalog.maxRepos": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "description": "Catalog screen: most repositories (most recent first) scanned for project-level configuration."
        },
        "agent.catalog.runCli": {
          "type": "boolean",
          "default": true,
          "description": "Catalog screen: run `claude --help` / `--version` and `codex --help` (trusted workspaces only, 5 s timeout, cached one day) to list CLI options."
        },
        "agent.settings.extraRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Settings screen: extra folders scanned for .claude/settings*.json, agents, skills and CLAUDE.md."
        },
        "agent.settings.maxRepos": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "description": "Settings screen: most repositories (most recent first) read for project settings layers."
        },
        "agent.settings.managed": {
          "type": "boolean",
          "default": true,
          "description": "Settings screen: also read the machine managed-settings.json (admin policy layer) if present."
        },
        "agent.transcript.maxBytes": {
          "type": "number",
          "default": 5242880,
          "minimum": 65536,
          "description": "Transcript screen: bytes read from the end of a transcript."
        },
        "agent.transcript.maxRecords": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "description": "Transcript screen: most conversation entries kept per transcript (oldest dropped first)."
        },
        "agent.transcript.pageSize": {
          "type": "number",
          "default": 150,
          "minimum": 20,
          "description": "Transcript screen: entries per page."
        },
        "agent.roles.patterns": {
          "type": "array",
          "default": [
            {
              "match": "^PM\\b|\\bPM\\b",
              "role": "PM"
            },
            {
              "match": "coordinat",
              "role": "coordinator"
            },
            {
              "match": "architect",
              "role": "architect"
            },
            {
              "match": "review",
              "role": "reviewer"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "match": {
                "type": "string",
                "description": "Case-insensitive regular expression tested on the session title."
              },
              "role": {
                "type": "string"
              }
            },
            "required": [
              "match",
              "role"
            ]
          },
          "description": "Roles screen: title patterns that name a session's role when no worker / subagent / workflow agent type is recorded. First match wins; the result is shown as INFERRED."
        },
        "agent.parallelTarget": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Target number of agents running at once: draws a target line on concurrency charts (0 = no target)."
        },
        "agent.health.contextWindow": {
          "type": "number",
          "default": 272000,
          "minimum": 1000,
          "description": "Reference context window and marker line; used as the window when the provider records none (Claude Code). A setting, not a fact."
        },
        "agent.health.warnPercent": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "description": "Context % at which bars, KPIs and badges turn red."
        },
        "agent.backlog.extraRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Backlog screen: extra folders scanned for plan files besides the repositories agents used."
        },
        "agent.backlog.maxRepos": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "description": "Backlog screen: most recent repositories scanned."
        },
        "agent.backlog.maxKB": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Backlog screen: plan files larger than this (KB) are skipped and listed."
        },
        "agent.backlog.archive": {
          "type": "boolean",
          "default": true,
          "description": "Backlog screen: also read handoff/archive/*.md for the weekly archive."
        },
        "agent.review.prState": {
          "type": "boolean",
          "default": false,
          "description": "Review screen: read PR / MR, CI and review state with gh / glab (read-only, network). Off: lanes from sessions and recorded commands only."
        },
        "agent.review.maxRepos": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "description": "Review screen: repositories queried (most recent first)."
        },
        "agent.review.limit": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Review screen: PRs / MRs listed per remote."
        },
        "agent.changes.maxSessions": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "Changes screen: most recent sessions whose commit window gets a git diff --numstat."
        },
        "agent.changes.maxWorktrees": {
          "type": "number",
          "default": 16,
          "minimum": 1,
          "description": "Changes screen: worktrees inspected for uncommitted work."
        },
        "agent.changes.worktreeHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "Changes screen: inspect a worktree if a session there is live or was active within this many hours."
        },
        "agent.changes.untracked": {
          "type": "boolean",
          "default": true,
          "description": "Changes screen: count untracked files."
        },
        "agent.limits.warnPercent": {
          "type": "number",
          "default": 70,
          "minimum": 1,
          "maximum": 100,
          "description": "Limits screen: warning threshold (%) for Codex used % and for the Claude block projection vs your largest past block."
        },
        "agent.limits.alertPercent": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "maximum": 100,
          "description": "Limits screen: alert threshold (%); also drives the rail badge (highest Codex used % at or above the warning threshold)."
        },
        "agent.dispatch.pricePerMTok": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          },
          "description": "Dispatches screen: optional price per million tokens by model id (e.g. {\"claude-opus-5-5\": 1.5}). Agent never prices tokens by itself; any $ shown is DERIVED from this setting (tokens incl. cache reads x your price). Empty = no money shown."
        },
        "agent.pipelines.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Pipelines screen: read GitHub Actions / GitLab CI through the gh / glab CLIs (read-only, network). Off by default."
        },
        "agent.pipelines.maxRepos": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "description": "Pipelines screen: most recently used agent repositories checked."
        },
        "agent.pipelines.runsPerRepo": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Pipelines screen: runs listed per remote."
        },
        "agent.pipelines.jobRuns": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "description": "Pipelines screen: runs per remote whose jobs are loaded (active first, then newest, then latest failures)."
        },
        "agent.pipelines.gitlabHosts": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Pipelines screen: extra self-managed GitLab host names."
        },
        "agent.pipelines.extraRepos": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Pipelines screen: extra local repository paths to include."
        },
        "agent.history.dir": {
          "type": "string",
          "default": "",
          "description": "History screen: folder holding the weekly archive (empty = ~/.agent/history). Written by npm run weekly or the screen's Build now."
        },
        "agent.history.maxWeeks": {
          "type": "number",
          "default": 52,
          "minimum": 1,
          "maximum": 520,
          "description": "History screen: how many of the newest week files are read."
        },
        "agent.archive.dir": {
          "type": "string",
          "default": "",
          "description": "Daily archive folder (empty = ~/.agent/archive). Written by npm run archive (scripts/install-archive-task.ps1 schedules it daily); read by the History and Backlog screens so sessions and plan items stay visible after Claude Code or Codex delete their files."
        },
        "agent.archive.maxDays": {
          "type": "number",
          "default": 400,
          "minimum": 1,
          "maximum": 5000,
          "description": "History / Backlog screens: how many of the newest daily archive files are read."
        },
        "agent.archive.rawTranscripts": {
          "type": "boolean",
          "default": false,
          "description": "Daily archive: also keep gzip copies of Claude transcripts and Codex rollouts in <archive>/raw. These raw copies are NOT redacted: they hold the full conversation text, including any key, token or password pasted in a prompt or printed by a tool. Local only; auth and secret files are never copied. Keep the archive folder private. Same as npm run archive -- --raw.",
          "markdownDescription": "Daily archive: also keep gzip copies of Claude transcripts and Codex rollouts in `<archive>/raw`.\n\n**Raw copies are NOT redacted**: they hold the full conversation text, including any key, token or password pasted in a prompt or printed by a tool. Local only; auth and secret files are never copied. Keep the archive folder private. Same as `npm run archive -- --raw`."
        },
        "agent.archive.rawMaxGB": {
          "type": "number",
          "default": 5,
          "minimum": 0.1,
          "maximum": 500,
          "description": "Daily archive: size cap of the raw transcript copies, in GB."
        },
        "agent.cockpit.assetRoots": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Explicitly approved local image roots for bounded gallery reads; no recursive scan."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc -p . --noEmit",
    "build": "node scripts/build.mjs",
    "compile-tests": "tsc -p tsconfig.test.json && node scripts/build-agent-host-tests.mjs",
    "test": "npm run compile-tests && node --test \"out-test/test/*.test.js\"",
    "package": "npm run build && vsce package --no-dependencies",
    "smoke": "node scripts/smoke.mjs",
    "perf": "npm run compile-tests && node out-test/scripts/perf.js",
    "weekly": "npm run compile-tests && node out-test/scripts/weekly.js",
    "archive": "npm run compile-tests && node out-test/scripts/archive.js",
    "benchmarks": "npm run compile-tests && node out-test/scripts/benchmarks.js",
    "export:conversations": "node dist/export-conversations.cjs",
